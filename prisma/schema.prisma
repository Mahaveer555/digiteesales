generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String           @id @default(uuid()) @map("_id")
  name          String
  email         String           @unique
  passwordHash  String
  role          String           @default("SALES_EXECUTIVE") // "SUPER_ADMIN" | "SALES_MANAGER" | "SALES_EXECUTIVE"
  department    String           @default("Field Sales")
  phone         String?
  avatarUrl     String?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  leads         Lead[]           @relation("AssignedLeads")
  meetings      Meeting[]
  followUps     FollowUp[]
  deals         Deal[]
  targets       SalesTarget[]
  attendances   Attendance[]
  notifications Notification[]
  timelines     ClientTimeline[]
}

model Lead {
  id                  String           @id @default(uuid()) @map("_id")
  companyName         String
  ownerName           String
  contactPerson       String?
  mobileNumber        String           @unique
  whatsappNumber      String?
  address             String
  city                String           @default("Indore")
  industryCategory    String           @default("Manufacturing")
  servicesRequired    String           @default("Website Development, SEO")
  leadSource          String           @default("Market Visit")
  firstMeetingDate    DateTime         @default(now())
  meetingTime         String           @default("11:00 AM")
  status              String           @default("NEW_LEAD")
  interestLevel       String           @default("MEDIUM")
  clientBudget        Float            @default(50000)
  dealValue           Float            @default(0)
  nextFollowUpDate    DateTime?
  nextFollowUpTime    String?
  followUpType        String?          @default("PHONE_CALL")
  expectedClosingDate DateTime?
  remarks             String?
  assignedToId        String
  assignedTo          User             @relation("AssignedLeads", fields: [assignedToId], references: [id])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  meetings            Meeting[]
  followUps           FollowUp[]
  deals               Deal[]
  timeline            ClientTimeline[]

  @@index([assignedToId])
  @@index([status])
}

model Meeting {
  id               String    @id @default(uuid()) @map("_id")
  leadId           String
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  meetingDate      DateTime
  meetingTime      String    @default("11:00 AM")
  meetingType      String    @default("MARKET_VISIT")
  status           String    @default("SCHEDULED")
  discussionPoints String?
  outcome          String?
  interestLevel    String    @default("MEDIUM")
  clientRemarks    String?
  nextAction       String?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([leadId])
  @@index([userId])
  @@index([meetingDate])
  @@index([status])
}

model FollowUp {
  id               String    @id @default(uuid()) @map("_id")
  leadId           String
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  scheduledDate    DateTime
  scheduledTime    String    @default("11:00 AM")
  dueDateTime      DateTime
  followUpType     String    @default("PHONE_CALL")
  status           String    @default("PENDING")
  priority         String    @default("MEDIUM")
  remarks          String?
  resolutionNotes  String?
  isOverdue        Boolean   @default(false)
  overdueSince     DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([leadId])
  @@index([userId])
  @@index([dueDateTime])
  @@index([status])
  @@index([isOverdue])
}

model Deal {
  id           String    @id @default(uuid()) @map("_id")
  leadId       String
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  dealTitle    String
  dealValue    Float     @default(0)
  status       String    @default("OPEN")
  closeDate    DateTime  @default(now())
  paymentTerms String    @default("50% Advance, 50% on Delivery")
  remarks      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([leadId])
  @@index([userId])
  @@index([status])
}

model SalesTarget {
  id             String   @id @default(uuid()) @map("_id")
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month          Int
  year           Int
  targetMeetings Int      @default(50)
  targetLeads    Int      @default(30)
  targetRevenue  Float    @default(500000)
  targetDeals    Int      @default(10)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, month, year])
  @@index([userId])
}

model Attendance {
  id        String    @id @default(uuid()) @map("_id")
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  punchIn   DateTime?
  punchOut  DateTime?
  status    String    @default("PRESENT")
  remarks   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([date])
}

model ClientTimeline {
  id           String   @id @default(uuid()) @map("_id")
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  activityType String
  title        String
  description  String
  metadata     String?
  createdAt    DateTime @default(now())

  @@index([leadId])
  @@index([userId])
}

model Notification {
  id            String    @id @default(uuid()) @map("_id")
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  message       String
  type          String    @default("SYSTEM")
  relatedLeadId String?
  isRead        Boolean   @default(false)
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([isRead])
}

model SystemSettings {
  id                      String   @id @default("default") @map("_id")
  companyName             String   @default("DIGITEE WORLD")
  productName             String   @default("Digitee World AI Sales CRM")
  timezone                String   @default("Asia/Kolkata")
  gracePeriodHours        Int      @default(2)
  pointsMeetingCompleted  Int      @default(10)
  pointsInterestedClient  Int      @default(15)
  pointsFinalDiscussion   Int      @default(20)
  pointsDealFinalized     Int      @default(50)
  penaltyOverdueFollowup  Int      @default(5)
  aiSalesSummaryEnabled   Boolean  @default(true)
  autoOverdueCheckMinutes Int      @default(15)
  updatedAt               DateTime @updatedAt
}

model AiDailyReport {
  id             String   @id @default(uuid()) @map("_id")
  reportDate     DateTime
  reportDateStr  String   @unique
  summaryJson    String
  insightsText   String
  actionPlanText String
  generatedAt    DateTime @default(now())
}
